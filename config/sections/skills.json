  "soft": [
    {
      "name": "Technical writing",
      "evidence": "I wrote 24 architecture decision records for jabbing, decision records and a deploy runbook for trust-desk, and about 90 docs for PeraPlano."
    },
    {
      "name": "Planning and phased delivery",
      "evidence": "tbn_game shipped in phases 0 to 4j, each with a written plan, a report and its own pull request; talyer ran ten documented phases and a gap audit."
    },
    {
      "name": "Learning fast",
      "evidence": "I taught myself Ruby and Rails while building trust-desk, and kept the learning guide and exercises in the repo."
    },
    {
      "name": "Product thinking",
      "evidence": "augrr's brief puts its users first: \"The end users are teachers, not developers. Every decision in this document is subordinate to that fact.\""
    },
    {
      "name": "Transparency",
      "evidence": "My AI usage reports record what the model wrote, what I decided and what it got wrong, and trust-desk keeps a bug log."
    },
    {
      "name": "Ownership of quality",
      "evidence": "On talyer I hold back dependency updates that fail, run every stock and money write in a transaction, and test restores from the nightly backups."
    },
    {
      "name": "Teamwork under pressure",
      "evidence": "Built Tara LEVEL UP! in 21 hours with team BOOM TARA TARA G at the AppBuildersPH Hackathon 2026."
