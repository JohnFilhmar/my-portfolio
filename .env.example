# Copy to .env.local and fill in what you need.
# Everything is optional — with no env vars at all the site runs and the
# assistant answers in demo mode (server-side intent matching, no API calls).

# --- AI assistant (server-side only — no NEXT_PUBLIC_ prefix!) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=              # leave blank to run the assistant in demo mode
LLM_MODEL=                # defaults to claude-opus-4-8 when blank
ASSISTANT_MODE=auto       # auto | demo | live  (auto = live if key present, else demo)
ASSISTANT_RATE_LIMIT=20   # requests per minute per IP (optional)

# --- Site ---
NEXT_PUBLIC_SITE_URL=     # e.g. https://yourdomain.com (falls back to config/site.json siteUrl)

# --- Contact ---
CONTACT_ENDPOINT=         # blank = mailto fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=olajohnfilhmar@gmail.com
SMTP_PASS=your-16-char-app-password   # NOT your Google password
SMTP_SECURE=false                     # 587=STARTTLS; set true only for port 465
# optional (both default to SMTP_USER):
CONTACT_TO=olajohnfilhmar@gmail.com
CONTACT_FROM=olajohnfilhmar@gmail.com
